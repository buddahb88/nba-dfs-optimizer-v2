# NBA DFS Optimizer V2 - Environment Variables

# =============================================================================
# DATABASE (PostgreSQL)
# =============================================================================
# Local Docker (matches docker-compose.yml)
DATABASE_URL="postgresql://nba_dfs:localdev@localhost:5432/nba_dfs"

# Or with your local Postgres
# DATABASE_URL="postgresql://user:password@localhost:5432/nba_dfs"

# Production (Railway, Supabase, Neon, etc.)
# DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# =============================================================================
# API SERVER
# =============================================================================
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000
API_URL=http://localhost:3001

# =============================================================================
# ROTOWIRE
# =============================================================================
# Copy the full cookie string from browser DevTools when logged into RotoWire
# Network tab -> any API request -> Headers -> Cookie
ROTOWIRE_COOKIES="PHPSESSID=your-session-id; g_uuid=your-uuid; ..."

# =============================================================================
# AI/OPENAI (Optional - for chat features)
# =============================================================================
# OPENAI_API_KEY=sk-...
# AZURE_OPENAI_KEY=...
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
